# syntax=docker/dockerfile:1
FROM rocker/shiny-verse:4.4
RUN apt-get update && apt-get install -yq \
    libbz2-dev \
    libhdf5-dev \
    libnetcdf-dev \
    build-essential \
    libgd-dev \
    libudunits2-dev \
    libproj-dev \
    libgdal-dev  \
    texlive-latex-base \
    texlive-fonts-recommended \
    texlive-fonts-extra \
    texlive-latex-extra

RUN Rscript -e 'install.packages(c("devtools", "BiocManager", "tidyverse", "ggrepel", "httr", "rjson", "mvtnorm", "tmvtnorm", \
"imputeLCMD", "plotly", "DT", "testthat", "RColorBrewer", "shiny","shinyalert","shinydashboard", \
"shinyjs", "svglite", "rhandsontable", "shinyBS", "shinyWidgets", "ggVennDiagram", "conflicted", "png", "vegan", "assertthat", "jsonlite", \
"shinycssloaders","data.table", "factoextra", "UpSetR","fastcluster","fdrtool"), dependencies=TRUE)'
### #FROM bioconductor/bioconductor_docker:RELEASE_3_19
RUN Rscript -e 'devtools::install_github("Appsilon/shiny.info")'
RUN Rscript -e 'BiocManager::install(pkgs=c("ensembldb", "EnsDb.Hsapiens.v86", "SummarizedExperiment", "limma", "ComplexHeatmap", "MSnbase", "missForest", "impute", "pcaMethods"), ask=F, dependencies=TRUE)'

### ===========================================================================
### ROOT CAUSE FIX: the igraph binary from Posit's noble repo links against
### GLPK, but libglpk40 is not in the base image. igraph therefore installs
### but cannot be loaded, which breaks QFeatures -> PSMatch -> MSnbase, plus
### clusterProfiler and ReactomePA (all depend on igraph).
###
### Deliberately a SEPARATE apt layer rather than an addition to the apt-get
### line at the top: editing that line would invalidate the cache for the hour
### of R package compilation below it.
### ===========================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglpk40 \
    libglpk-dev \
    && rm -rf /var/lib/apt/lists/*

RUN Rscript -e 'library(igraph); cat("igraph loads OK\n")'

### ===========================================================================
### DIAGNOSTIC MODE: install the packages the original list forgot, one at a
### time, logging every failure to /build-logs/ inside the image. This RUN never
### fails the build, so the container always starts and the logs can be read.
###
### MAKEFLAGS=-j1 keeps peak compiler memory low: mzR bundles the ProteoWizard
### C++ sources and parallel make is what gets OOM-killed on small hosts.
### ===========================================================================
ENV MAKEFLAGS="-j1"

RUN <<'RSCRIPT' cat > /tmp/install_extras.R
options(Ncpus = 1)

pkgs_cran <- c("rmdformats")
pkgs_bioc <- c("ProtGenerics", "mzR", "MSnbase", "impute", "pcaMethods",
               "missForest", "clusterProfiler", "ReactomePA",
               "org.Hs.eg.db", "org.Mm.eg.db")

for (p in c(pkgs_cran, pkgs_bioc)) {
  cat("\n\n##### INSTALLING:", p, "#####\n")
  tryCatch({
    if (p %in% pkgs_cran) {
      install.packages(p, dependencies = NA)
    } else {
      BiocManager::install(p, ask = FALSE, update = FALSE, dependencies = NA)
    }
  }, error = function(e) cat("R-LEVEL ERROR for ", p, ": ", conditionMessage(e), "\n", sep = ""))
  ok <- p %in% rownames(installed.packages())
  cat("##### RESULT:", p, if (ok) "OK" else "FAILED", "#####\n")
}

req <- c("MSnbase", "mzR", "ProtGenerics", "impute", "pcaMethods", "missForest",
         "clusterProfiler", "ReactomePA", "org.Hs.eg.db", "org.Mm.eg.db", "rmdformats",
         "ensembldb", "EnsDb.Hsapiens.v86", "SummarizedExperiment", "limma",
         "ComplexHeatmap", "imputeLCMD", "tmvtnorm", "mvtnorm", "shiny",
         "shinydashboard", "shinyjs", "shinyalert", "shinyBS", "shinyWidgets",
         "shinycssloaders", "rhandsontable", "plotly", "DT", "svglite",
         "ggVennDiagram", "ggrepel", "factoextra", "UpSetR", "vegan",
         "fastcluster", "fdrtool", "shiny.info", "conflicted", "data.table",
         "httr", "rjson", "jsonlite", "png", "assertthat")

miss <- req[!req %in% rownames(installed.packages())]
writeLines(if (length(miss)) miss else "none", "/build-logs/MISSING_PACKAGES.txt")
cat("\n\n########## MISSING AT END OF BUILD:",
    if (length(miss)) paste(miss, collapse = ", ") else "none", "##########\n")
RSCRIPT

RUN <<'SH' bash
set -x
mkdir -p /build-logs
echo "=== build-time memory ==="  >  /build-logs/build-env.log
free -h                           >> /build-logs/build-env.log 2>&1
echo "=== cpus: $(nproc) ==="     >> /build-logs/build-env.log

# Never fail the build - we want the container up so the logs are readable.
Rscript /tmp/install_extras.R > /build-logs/bioc-install.log 2>&1 || true

# Surface the important lines in the Portainer build output.
echo "########## PER-PACKAGE RESULTS ##########"
grep -E "^##### RESULT|^R-LEVEL ERROR|^########## MISSING" /build-logs/bioc-install.log || true
echo "########## MEMORY / COMPILER FAILURES ##########"
grep -iE "killed|cannot allocate|virtual memory exhausted|out of memory|fatal error|non-zero exit status" /build-logs/bioc-install.log | head -30 || true
echo "########## PACKAGES THAT INSTALL BUT FAIL TO LOAD ##########"
Rscript -e 'pkgs <- rownames(installed.packages()); bad <- character();
for (p in pkgs) { ok <- tryCatch(suppressMessages(requireNamespace(p, quietly=TRUE)), error=function(e) FALSE, warning=function(w) FALSE);
  if (!isTRUE(ok)) bad <- c(bad, p) };
writeLines(if (length(bad)) bad else "none", "/build-logs/UNLOADABLE_PACKAGES.txt");
cat(if (length(bad)) paste(bad, collapse=", ") else "none", "\n")' 2>&1 | tail -5
echo "########## END - full log at /build-logs/bioc-install.log ##########"
SH

COPY ./ /srv/shiny-server/fragpipe-analyst
COPY shiny-server.conf.prod /etc/shiny-server/shiny-server.conf

### replace google_analytics.html with a new empty file
WORKDIR /srv/shiny-server/fragpipe-analyst
RUN rm "google_analytics.html" && touch "google_analytics.html"

### Drop .Rprofile so renv's autoloader never runs inside the container.
RUN rm -f .Rprofile

RUN chmod -R +r /srv/shiny-server/fragpipe-analyst
